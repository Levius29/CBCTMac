{
  "name": "openmri",
  "version": "2.0.0",
  "description": "Local viewer for your own MRI and CT studies: 3D volume rendering, three linked slices, import from DICOM/NIfTI archives, and rigid registration across dates.",
  "license": "MIT",
  "author": "Maksim Khuzin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lev1nson/OpenMRI.git"
  },
  "homepage": "https://github.com/lev1nson/OpenMRI#readme",
  "bugs": {
    "url": "https://github.com/lev1nson/OpenMRI/issues"
  },
  "keywords": [
    "mri",
    "ct",
    "dicom",
    "nifti",
    "medical-imaging",
    "viewer",
    "niivue",
    "local-first"
  ],
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev -H 127.0.0.1 -p 4173",
    "build": "vinext build",
    "start": "vinext start -H 127.0.0.1 -p 4173",
    "up": "bash scripts/server.sh start",
    "down": "bash scripts/server.sh stop",
    "status": "bash scripts/server.sh status",
    "demo": "bash scripts/server.sh start --no-open && node scripts/demo.mjs",
    "lint": "oxlint app lib vite.config.ts",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:import": ".venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@niivue/niivue": "0.69.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
